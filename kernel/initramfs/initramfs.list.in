# gen_init_cpio list for the slim initramfs built into the kernel.
# scripts/build-kernel.sh replaces @DIR@ (this directory) and @BUSYBOX@ (static busybox).
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0
dir /usr/sbin 0755 0 0
dir /etc 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /dev 0755 0 0
dir /tmp 1777 0 0
dir /run 0755 0 0
dir /root 0700 0 0
dir /mnt 0755 0 0
dir /newroot 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
file /bin/busybox @BUSYBOX@ 0755 0 0
slink /bin/sh busybox 0777 0 0
file /init @DIR@/init 0755 0 0
file /etc/profile @DIR@/profile 0644 0 0
