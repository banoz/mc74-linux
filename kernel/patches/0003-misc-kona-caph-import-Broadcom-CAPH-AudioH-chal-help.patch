+    reg_val |= (time&CPH_SSASW_PREADY_MAX_TIME_PREADY_MAX_TIME_MASK);
+    BRCM_WRITE_REG( base,  CPH_SSASW_PREADY_MAX_TIME,reg_val);
+
+    return;
+}
