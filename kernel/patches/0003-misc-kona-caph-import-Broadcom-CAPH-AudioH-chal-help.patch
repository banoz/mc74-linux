+/****************************************************************************
+*
+*  Function Name: CHAL_HANDLE chal_caph_intc_init(uint32_t baseAddress)
+*
+*  Description: Initialize CAPH INTC
+*
+****************************************************************************/
+CHAL_HANDLE chal_caph_intc_init(uint32_t baseAddress)
+{
+    return(CHAL_HANDLE)baseAddress;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_deinit(CHAL_HANDLE handle)
+*
+*  Description: Deinitialize CAPH INTC
+*
+****************************************************************************/
+void chal_caph_intc_deinit(CHAL_HANDLE handle)
+{
+    (void)handle;
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_reset(CHAL_HANDLE handle)
+*
+*  Description: Reset CAPH INTC
+*
+****************************************************************************/
+void chal_caph_intc_reset(CHAL_HANDLE handle)
+{
+    uint32_t base = (uint32_t)handle;
+
+    /* Create a reset Pulse */
+    /* Make sure reset bit is 0 */
+    BRCM_WRITE_REG(base, AHINTC_AHINTC_CONTROL, 0x0000);
+
+    /* Set Rest to 1 */
+    BRCM_WRITE_REG(base, AHINTC_AHINTC_CONTROL, AHINTC_AHINTC_CONTROL_AHINTC_SOFT_RESET_MASK);
+
+    /* Set Rest to 0 */
+    BRCM_WRITE_REG(base, AHINTC_AHINTC_CONTROL, 0x0000);
+
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_enable_cfifo_intr(CHAL_HANDLE handle,
+*            uint16_t fifo,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Enable CAPH INTC CFIFO INT
+*
+****************************************************************************/
+void chal_caph_intc_enable_cfifo_intr(CHAL_HANDLE handle,
+            uint16_t fifo,
+            CAPH_ARM_DSP_e owner)
+{
+    uint32_t base = (uint32_t)handle;
+    uint32_t int_en;
+
+    int_en = BRCM_READ_REG_IDX(base, AHINTC_ENABLE_ARM_STD_0, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE));
+    int_en |= (fifo << AHINTC_ENABLE_ARM_STD_0_ENABLE_A_S_CFIFO_CH16_1_SHIFT);
+    BRCM_WRITE_REG_IDX(base, AHINTC_ENABLE_ARM_STD_0, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE), int_en);
+
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_disable_cfifo_intr(CHAL_HANDLE handle,
+*            uint16_t fifo,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Disable CAPH INTC CFIFO INT
+*
+****************************************************************************/
+void chal_caph_intc_disable_cfifo_intr(CHAL_HANDLE handle,
+            uint16_t fifo,
+            CAPH_ARM_DSP_e owner)
+{
+    uint32_t base = (uint32_t)handle;
+    uint32_t int_en;
+    uint32_t int_dis = (fifo << AHINTC_ENABLE_ARM_STD_0_ENABLE_A_S_CFIFO_CH16_1_SHIFT);
+
+    int_en = BRCM_READ_REG_IDX(base, AHINTC_ENABLE_ARM_STD_0, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE));
+    int_en &= (~int_dis);
+    BRCM_WRITE_REG_IDX(base, AHINTC_ENABLE_ARM_STD_0, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE), int_en);
+
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_clr_cfifo_intr(CHAL_HANDLE handle,
+*            uint16_t fifo,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Clear CAPH INTC CFIFO INT
+*
