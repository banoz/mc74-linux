+ *                                 uint32_t ihf_dither_seed_L, uint32_t ihf_dither_seed_R)
+ * 
+ *  Description:  Write the dither seed to sigma delta module on IHF path
+ * 
+ *  Parameters:   handle - audio chal handle.
+ *                  ihf_dither_seed_L - left channel dither seed value
+ *                  ihf_dither_seed_R - right channel dither seed value
+ * 
+ *  Return:       None.
+ * 
+ * ============================================================================
+ */
+
+void chal_audio_ihfpath_sdm_set_dither_seed(CHAL_HANDLE handle, uint32_t ihf_dither_seed_L, uint32_t ihf_dither_seed_R)
+{
+    uint32_t base =    ((ChalAudioCtrlBlk_t*)handle)->audioh_base;
+
+    BRCM_WRITE_REG(base, AUDIOH_IHF_DITHER_SEED_L, (ihf_dither_seed_L & AUDIOH_STEREO_DITHER_SEED_L_STEREO_DITHER_SEED_L_MASK));
+    BRCM_WRITE_REG(base, AUDIOH_IHF_DITHER_SEED_R, (ihf_dither_seed_R & AUDIOH_STEREO_DITHER_SEED_R_STEREO_DITHER_SEED_R_MASK));
+
+    return;
+}
+
+/*
+ * ============================================================================
+ * 
+ *  Function Name: void chal_audio_ihfpath_get_dma_port_addr(CHAL_HANDLE handle,
+ *                                     uint32_t *dma_addr)
+ * 
+ *  Description:  Get the DMA port physical address on IHF path
+ * 
+ *  Parameters:   handle     - audio chal handle.
+ *                dma_addr   - point to address to return DMA physical address
+ *  Return:       None.
+ * 
+ * ============================================================================
+ */
+
+void chal_audio_ihfpath_get_dma_port_addr(CHAL_HANDLE handle, uint32_t *dma_addr)
+{
+    uint32_t base =    ((ChalAudioCtrlBlk_t*)handle)->audioh_base;
+
+	*dma_addr = (uint32_t)(base) + AUDIOH_IHF_FIFO_DATA_OFFSET;
+
+    return;
+}
+
+/*
+ * ============================================================================
+ * 
+ *  Function Name: uint32_t chal_audio_ihfpath_get_dma_port_addr_offset()
+ * 
+ *  Description:  Get the DMA address offset on IHF path
+ * 
+ *  Return:       Offset for the DMA address.
+ * 
+ * ============================================================================
+ */
+uint32_t chal_audio_ihfpath_get_dma_port_addr_offset( void )
+{
+   return AUDIOH_IHF_FIFO_DATA_OFFSET;
+}
+
+/*
+ * ============================================================================
+ * 
+ *  Function Name: void chal_audio_ihfpath_int_clear(CHAL_HANDLE handle, uint16_t thr_int_enable, uint16_t err_int_enable )
+ * 
+ *  Description:  Clear interrupt on IHF path
+ * 
+ *  Parameters:   handle      : the IHF pathhandle.
+ *                       thr_int      : Clear FIFO threshold interrupt
+ *                       err_int      : Clear FIFO Error interrupt
+ * 
+ *  Return:       None.
+ * 
+ * ============================================================================
+ */
+void chal_audio_ihfpath_int_clear(CHAL_HANDLE handle, _Bool thr_int, _Bool err_int)
+{
+    uint32_t base =    ((ChalAudioCtrlBlk_t*)handle)->audioh_base;
+    uint32_t reg_val = 0;
+
+    if(thr_int == TRUE)
+    {
+        reg_val |= AUDIOH_AUDIO_INT_STATUS_IHF_INT_MASK;
+    }
+
+    if(err_int == TRUE)
+    {
+        reg_val |= AUDIOH_AUDIO_INT_STATUS_IHF_FIFO_ERR_MASK;
+    }
+
+    /* Set the required setting */
+    BRCM_WRITE_REG(base,  AUDIOH_AUDIO_INT_STATUS, reg_val);
+
+    return;
+}
+
+
+/*
+ * ============================================================================
+ * 
+ *  Function Name: void chal_audio_ihfpath_set_dac_pwr(CHAL_HANDLE handle,
+ *                                     uint16_t enable_chan)
+ * 
+ *  Description:  Set DAC power for the IHF DAC
+ * 
+ *  Parameters:   handle     - audio chal handle.
+ *                enable_chan   - Specifies which DAC channel power need to be enabled or disabled
+ *  Return:       None.
+ * 
+ * ============================================================================
+ */
+
+void chal_audio_ihfpath_set_dac_pwr(CHAL_HANDLE handle, uint16_t enable_chan)
+{
+    uint32_t base =    ((ChalAudioCtrlBlk_t*)handle)->audioh_base;
+    uint32_t reg_value;
+
+    reg_value = BRCM_READ_REG(base, AUDIOH_IHF_PWR);
+
+
+    if(enable_chan&CHAL_AUDIO_CHANNEL_LEFT)
+    {
+        /* Clear power down */
+       reg_value &= ~AUDIOH_IHF_PWR_AUDIOTX_IHF_DACL_PD_MASK;
+    }
+    else
+    {
+        /* Set power down */
+        reg_value |= AUDIOH_IHF_PWR_AUDIOTX_IHF_DACL_PD_MASK;
+    }
+
+    if(enable_chan&CHAL_AUDIO_CHANNEL_RIGHT)
+    {
+        /* Clear power down */
+        reg_value &= ~AUDIOH_IHF_PWR_AUDIOTX_IHF_DACR_PD_MASK;
+    }
+    else
+    {
+        /* Set power down */
+        reg_value |= AUDIOH_IHF_PWR_AUDIOTX_IHF_DACR_PD_MASK;
+    }
+
+    BRCM_WRITE_REG(base, AUDIOH_IHF_PWR, reg_value);
+
+    reg_value = BRCM_READ_REG(base, AUDIOH_EP_PWR);
+
+    if(enable_chan)
+    {
+        reg_value &= ~AUDIOH_EP_PWR_AUDIOTX_EP_IHF_REF_PD_MASK;
+        reg_value &= ~AUDIOH_EP_PWR_AUDIOTX_EP_RESET_MASK;
+    }
+    else
+    {
+        /* Need to check if EP is also running or not */
+        reg_value |= AUDIOH_EP_PWR_AUDIOTX_EP_IHF_REF_PD_MASK;
+        reg_value |= AUDIOH_EP_PWR_AUDIOTX_EP_RESET_MASK;
+    }
+
+    BRCM_WRITE_REG(base, AUDIOH_EP_PWR, reg_value);
+
+    return;
+}
+
+/*
+ * ============================================================================
+ * 
+ *  Function Name: void chal_audio_ihfpath_set_filter(CHAL_HANDLE handle, uint16_t filter)
+ * 
+ *  Description:  set Filter type for the IHF  path
+ * 
+ *  Parameters:   handle    - audio chal handle.
+ *                  filter    -  0: Linear Phase, 1 Minimum Phase
+ *  Return:       None.
+ * 
+ */
+
+/*============================================================================*/
+void chal_audio_ihfpath_set_filter(CHAL_HANDLE handle, uint16_t filter)
+{
+    uint32_t base =    ((ChalAudioCtrlBlk_t*)handle)->audioh_base;
+    uint32_t reg_val;
+
+
+    reg_val = BRCM_READ_REG(base, AUDIOH_MIN_PHASE);
+    reg_val &= ~(AUDIOH_MIN_PHASE_IHF_MIN_PHASE_MASK);
+
+    if(filter & CHAL_AUDIO_MINIMUM_PHASE_FILTER)
+    {
+        reg_val |= AUDIOH_MIN_PHASE_IHF_MIN_PHASE_MASK;
+    }
+    /* Set the required setting */
+    BRCM_WRITE_REG(base,  AUDIOH_MIN_PHASE, reg_val);
+
+    return;
+}
