+    if(thr_int == TRUE)
+    {
+        reg_val |= AUDIOH_AUDIO_INT_STATUS_VINL_INT_MASK;
+    }
+
+    if(err_int == TRUE)
+    {
+        reg_val |= AUDIOH_AUDIO_INT_STATUS_VIN_FIFOL_ERR_MASK;
+    }
+
+    /* Set the required setting */
+    BRCM_WRITE_REG(base,  AUDIOH_AUDIO_INT_STATUS, reg_val);
+
+    return;
+}
