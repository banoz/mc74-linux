+*  Function Name: void chal_caph_intc_disable_tap_int_err(CHAL_HANDLE handle,
+*            uint8_t channel,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Disable CAPH INTC TAP INT err
+*
+****************************************************************************/
+void chal_caph_intc_disable_tap_int_err(CHAL_HANDLE handle,
+            uint8_t channel,
+            CAPH_ARM_DSP_e owner)
+{
+    uint32_t base = *(uint32_t*)handle;
+    uint32_t int_en;
+    uint32_t int_dis = (channel << AHINTC_ENABLE_ARM_ERR_1_ENABLE_A_E_TAP_INCH4_1_SHIFT);
+
+    int_en = BRCM_READ_REG_IDX(base, AHINTC_ENABLE_ARM_ERR_1, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE));
+    int_en &= ~(int_dis);
+    BRCM_WRITE_REG_IDX(base, AHINTC_ENABLE_ARM_ERR_1, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE), int_en);
+
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_clr_tap_int_err(CHAL_HANDLE handle,
+*            uint8_t channel,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Clear CAPH INTC TAP INT err
+*
+****************************************************************************/
+void chal_caph_intc_clr_tap_int_err(CHAL_HANDLE handle,
+            uint8_t channel,
+            CAPH_ARM_DSP_e owner)
+{
+    uint32_t base = *(uint32_t*)handle;
+    uint32_t int_clr;
+
+    int_clr = BRCM_READ_REG_IDX(base, AHINTC_CLEAR_ARM_ERR_1, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE));
+    int_clr |= (channel << AHINTC_CLEAR_ARM_ERR_1_CLEAR_A_E_TAP_INCH4_1_SHIFT);
+    BRCM_WRITE_REG_IDX(base, AHINTC_CLEAR_ARM_ERR_1, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE), int_clr);
+
+    return;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_read_tap_int_err(CHAL_HANDLE handle,
+*            CAPH_ARM_DSP_e owner)
+*
+*  Description: Read CAPH INTC TAP INT err
+*
+****************************************************************************/
+uint8_t chal_caph_intc_read_tap_int_err(CHAL_HANDLE handle,
+            CAPH_ARM_DSP_e owner)
+{
+    uint32_t base = *(uint32_t*)handle;
+    uint32_t int_sts;
+
+    int_sts = BRCM_READ_REG_IDX(base, AHINTC_STATUS_ARM_ERR_1, (owner*CHAL_CAPH_INTC_SUBSYS_REG_SIZE));
+    int_sts &= (AHINTC_STATUS_ARM_ERR_1_STATUS_A_E_TAP_INCH4_1_MASK|AHINTC_STATUS_ARM_ERR_1_STATUS_A_E_TAP_OUTCH4_1_MASK);
+    int_sts >>= (AHINTC_STATUS_ARM_ERR_1_STATUS_A_E_TAP_INCH4_1_SHIFT);
+
+    return int_sts;
+}
+
+/****************************************************************************
+*
+*  Function Name: void chal_caph_intc_set_tap_int_detect_level(CHAL_HANDLE handle,
+*            uint8_t channel,
+*            uint8_t detectLevel)
+*
+*  Description: Set CAPH INTC TAP INT detect level
+*
+****************************************************************************/
+void chal_caph_intc_set_tap_int_detect_level(CHAL_HANDLE handle,
+            uint8_t channel,
+            uint8_t detectLevel)
+{
+    uint32_t base = *(uint32_t*)handle;
+    uint32_t level_detect;
+
+    level_detect = BRCM_READ_REG(base, AHINTC_LEVELDETECT_1);
+
+    /* Clear the required ssp settings */
+    level_detect &= (~(channel << AHINTC_LEVELDETECT_1_LEVEL_TAP_INCH4_1_SHIFT));
+    /* Add the level detection settings for the given channels */
+    level_detect |= ((channel&detectLevel) << AHINTC_LEVELDETECT_1_LEVEL_TAP_INCH4_1_SHIFT);
+
+    /* Apply the settings */
+    BRCM_WRITE_REG(base, AHINTC_LEVELDETECT_1, level_detect);
+
+    return;
+}
